        <Filename Value="WaveRiderStudio.lpr"/>
        <IsPartOfProject Value="True"/>
      </Unit>
      <Unit>
        <Filename Value="src\ustudiomain.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="uStudioMain"/>
      </Unit>
      <Unit>
        <Filename Value="src\uparampanel.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="uParamPanel"/>
      </Unit>
      <Unit>
        <Filename Value="src\upreview.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="uPreview"/>
      </Unit>
      <Unit>
        <Filename Value="srcse.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="uEdBase"/>
      </Unit>
      <Unit>
        <Filename Value="src\uedscreens.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="uEdScreens"/>
      </Unit>
      <Unit>
        <Filename Value="src\uedsound.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="uEdSound"/>
      </Unit>
      <Unit>
        <Filename Value="src\uedmusic.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="uEdMusic"/>
      </Unit>
      <Unit>
        <Filename Value="src\uedlevels.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="uEdLevels"/>
      </Unit>
      <Unit>
        <Filename Value="src\uedobjects.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="uEdObjects"/>
      </Unit>
      <Unit>
        <Filename Value="src\uedlight.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="uEdLight"/>
      </Unit>
    </Units>
  </ProjectOptions>
  <CompilerOptions>
    <Version Value="11"/>
    <Target>
      <Filename Value="..\bin\WaveRiderStudio"/>
    </Target>
    <SearchPaths>
      <IncludeFiles Value="$(ProjOutDir);src;..\src;..\..\DottedWave\src"/>
      <OtherUnitFiles Value="src;..\src;..\..\DottedWave\src"/>
      <UnitOutputDirectory Value="lib\$(TargetCPU)-$(TargetOS)"/>
    </SearchPaths>
    <CodeGeneration>
      <SmartLinkUnit Value="True"/>
      <Optimizations>
        <OptimizationLevel Value="3"/>
      </Optimizations>
